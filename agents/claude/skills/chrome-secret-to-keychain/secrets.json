{
  "algolia-app-id": {
    "host": "dashboard.algolia.com",
    "label": "Application ID",
    "pattern": "^[A-Z0-9]{10}$",
    "keychainService": "diggram-algolia-app-id"
  },
  "algolia-write-key": {
    "host": "dashboard.algolia.com",
    "label": "Write API Key",
    "pattern": "^[A-Za-z0-9]{32}$",
    "keychainService": "diggram-algolia-write-key",
    "revealSelector": "button[aria-label='Show/Hide']"
  },
  "algolia-app-search-key": {
    "host": "dashboard.algolia.com",
    "label": "Diggram iOS app (search only)",
    "pattern": "^[A-Za-z0-9]{32}$",
    "keychainService": "diggram-algolia-search-key",
    "direction": "before"
  },
  "r2-access-key-id": {
    "host": "dash.cloudflare.com",
    "label": "Access Key ID",
    "pattern": "^[a-f0-9]{32}$",
    "keychainService": "diggram-r2-access-key-id"
  },
  "r2-secret-access-key": {
    "host": "dash.cloudflare.com",
    "label": "Secret Access Key",
    "pattern": "^[a-f0-9]{64}$",
    "keychainService": "diggram-r2-secret-access-key"
  }
}
